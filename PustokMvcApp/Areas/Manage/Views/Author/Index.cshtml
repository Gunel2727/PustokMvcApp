@model List<Author>

@{
    ViewData["Title"] = "Authors";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between mb-4">
        <h3>Authors</h3>

        <a asp-action="Create" class="btn btn-success"
           data-bs-toggle="collapse" data-bs-target="#createSection">
            Create
        </a>
    </div>

  

    <!-- TABLE -->
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th width="250">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var author in Model)
            {
                <tr>
                    <td>@author.Id</td>
                    <td>@author.FullName</td>

                    <td>
                        <!-- DETAILS -->
                        <a href="@Url.Action("DetailsModal", "Author", new { id = author.Id })"
                           class="btn btn-info btn-sm detailsAuthor">
                            Details
                        </a>

                        <!-- EDIT -->
                        <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-warning btn-sm"
                           data-bs-toggle="collapse" data-bs-target="#e@author.Id">
                            Edit
                        </a>

                        <!-- DELETE (IMPORTANT PART) -->
                        <a asp-action="Delete" asp-route-id="@author.Id" "
                           class="btn btn-danger btn-sm deleteAuthor">
                            Delete
                        </a>
                    </td>
                </tr>


                <!-- EDIT -->
                <tr class="collapse" id="e@author.Id">
                    <td colspan="3">
                        <form method="post"
                              action="@Url.Action("Edit","Author", new { id = author.Id })"
                              class="p-2">

                            <input type="hidden" name="Id" value="@author.Id" />

                            <input type="text" name="FullName"
                                   value="@author.FullName"
                                   class="form-control mb-2" />

                            <button class="btn btn-primary btn-sm">Save</button>

                            <a href="#" class="btn btn-secondary btn-sm"
                               data-bs-toggle="collapse"
                               data-bs-target="#e@author.Id">
                                Cancel
                            </a>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="modal fade" id="authorModal" tabindex="-1">
        <div class="modal-dialog modal-lg">

            <div class="modal-content">
                <!-- AJAX buraya inject edəcək -->
                <div id="authorModalBody"></div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(".deleteAuthor").click(function (e) {
            e.preventDefault();
                   Swal.fire({
                  title: "Do you want to delete author?",
                  showCancelButton: true,
                  confirmButtonText: "Delete",
                }).then((result) => {
          /* Read more about isConfirmed, isDenied below */
          if (result.isConfirmed)
          {
			  var url = $(this).attr("href");
              $.ajax({
                  url: url,
                  type: "GET",
                  success: function () {
                      Swal.fire("Author is deleted!", "", "success").then(() => location.reload());
                  },
                  error: function () {
                      Swal.fire("An error occurred while deleting the author.", "", "error");
                  }
			  });
          }
          else if (result.isDenied) Swal.fire("Changes are not saved", "", "info");
        });
		});

                 $(document).on("click", ".detailsAuthor", function (e) {
            e.preventDefault();

            var url = $(this).attr("href");

            $.get(url, function (res) {

                $("#authorModalBody").html(res);

                var modal = new bootstrap.Modal(document.getElementById('authorModal'));
                modal.show();
            });
        });

	</script>
}