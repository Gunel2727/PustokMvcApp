@model Book

@{
    ViewData["Title"] = "Create Book";
    var authors = ViewBag.Authors as List<Author> ?? new List<Author>();
    var tags = ViewBag.Tags as List<Tag> ?? new List<Tag>();
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Create Book</h2>

        <a asp-action="Index" asp-controller="Book" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>

    <form asp-area="Manage" asp-controller="Book" asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <!-- BASIC INFO -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light fw-semibold">
                Basic Information
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DiscountPercent" class="form-label"></label>
                        <input asp-for="DiscountPercent" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AuthorId" class="form-label"></label>
                        <select asp-for="AuthorId"
                                asp-items="@(new SelectList(authors, "Id", "FullName"))" 
                                class="form-select">
                            <option value="">Select Author</option>
                        </select>
                        <span asp-validation-for="AuthorId" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- DESCRIPTION -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light fw-semibold">
                Description
            </div>

            <div class="card-body">
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <!-- IMAGES -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light fw-semibold">
                Images
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="MainPhoto" class="form-label"></label>
                        <input asp-for="MainPhoto" type="file" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="HoverPhoto" class="form-label"></label>
                        <input asp-for="HoverPhoto" type="file" class="form-control" />

                    </div>

                    <div class="col-md-4">
                        <label asp-for="Files" class="form-label"></label>
                        <input asp-for="Files" type="file" multiple class="form-control" />
                    </div>

                </div>
            </div>
        </div>

        <!-- TAGS -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light fw-semibold">
                Tags
            </div>

            <div class="card-body">
                <select asp-for="TagIds"
                        asp-items="@(new SelectList(tags, "Id", "Name"))" 
                        class="form-select"
                        multiple>
                </select>
                <span asp-validation-for="TagIds" class="text-danger"></span>
            </div>
        </div>

        <!-- OPTIONS -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light fw-semibold">
                Options
            </div>

            <div class="card-body d-flex gap-4">

                <div class="form-check">
                    <input asp-for="InStock" class="form-check-input" />
                    <label asp-for="InStock" class="form-check-label"></label>
                </div>

                <div class="form-check">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label"></label>
                </div>

                <div class="form-check">
                    <input asp-for="IsNew" class="form-check-input" />
                    <label asp-for="IsNew" class="form-check-label"></label>
                </div>

            </div>
        </div>

        <!-- SUBMIT -->
        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>

    </form>

</div>

@section scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js" integrity="sha512-KFHXdr2oObHKI9w4Hv1XPKc898mE4kgYx58oqsc/JqqdLMDI4YjOLzom+EMlW8HFUd0QfjfAvxSL6sEq/a42fQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" integrity="sha512-xq+Vm8jC94ynOikewaQXMEkJIOBp7iArs3IhFWSWdRT3Pq8wFz46p+ZDFAR7kHnSFf+zUv52B3prRYnbDRdgog==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}