@model List<Slider>

@{
    ViewData["Title"] = "Sliders";
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <!-- LEFT: TITLE -->
    <h2 class="mb-0 fw-bold">Sliders</h2>

    <!-- RIGHT: CREATE BUTTON -->
    <a asp-action="Create" class="btn btn-success"
       data-bs-toggle="collapse" data-bs-target="#createSection">
        Create
    </a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">ID</th>
                <th style="width: 20%;">Image</th>
                <th style="width: 50%;">Title</th>
                <th style="width: 20%;" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slider in Model)
            {
                <tr>
                    <!-- ID -->
                    <td><strong>@slider.Id</strong></td>

                    <!-- IMAGE -->
                    <td>
                        @if (!string.IsNullOrEmpty(slider.ImageUrl))
                        {
                            <img src="@Url.Content("~/assets/image/bg-images/" + slider.ImageUrl)"
                                 alt="slider image"
                                 style="width:100px; height:60px; object-fit:cover; border-radius:6px;" />
                        }
                        else
                        {
                            <span class="badge bg-warning">No Image</span>
                        }
                    </td>

                    <!-- TITLE -->
                    <td>@slider.Title</td>

                    <!-- ACTIONS -->
                    <td class="text-center">
                        <!-- DETAILS -->
                        <a href="@Url.Action("Details", "Slider", new { id = slider.Id })"
                           class="btn btn-info btn-sm detailsSlider">
                            Details
                        </a>

                        <!-- EDIT -->
                        <a asp-action="Edit" asp-route-id="@slider.Id" class="btn btn-warning btn-sm"
                           data-bs-toggle="collapse" data-bs-target="#e@author.Id">
                            Edit
                        </a>

                        <!-- DELETE (IMPORTANT PART) -->
                        <a asp-action="Delete" asp-route-id="@slider.Id" "
                           class="btn btn-danger btn-sm deleteAuthor">
                            Delete
                        </a>
                    </td>
                </tr>

                <!-- DETAILS -->
                <tr class="collapse" id="detailsForm@slider.Id">
                    <td colspan="4">
                        <div class="card card-body bg-info bg-opacity-10 mt-2">
                            <strong>Description:</strong>
                            <p>@slider.Description</p>
                        </div>
                    </td>
                </tr>

                <!-- EDIT -->
                <tr class="collapse" id="editForm@slider.Id">
                    <td colspan="4">
                        <div class="card card-body bg-light mt-2">
                            <form method="post" action="@Url.Action("Edit", "Slider", new { id = slider.Id })">
                                <input type="hidden" name="Id" value="@slider.Id" />

                                <div class="mb-2">
                                    <label>Title</label>
                                    <input type="text" name="Title" class="form-control" value="@slider.Title" />
                                </div>

                                <div class="mb-2">
                                    <label>Image URL</label>
                                    <input type="text" name="ImageUrl" class="form-control" value="@slider.ImageUrl" />
                                </div>

                                <button class="btn btn-primary btn-sm">Save</button>
                            </form>
                        </div>
                    </td>
                </tr>

                <!-- DELETE -->
                <tr class="collapse" id="deleteForm@slider.Id">
                    <td colspan="4">
                        <div class="card card-body bg-danger bg-opacity-10 mt-2">
                            <p>Are you sure you want to delete <strong>@slider.Title</strong>?</p>

                            <form method="post" action="@Url.Action("DeleteConfirmed", "Slider", new { id = slider.Id })">
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js" integrity="sha512-KFHXdr2oObHKI9w4Hv1XPKc898mE4kgYx58oqsc/JqqdLMDI4YjOLzom+EMlW8HFUd0QfjfAvxSL6sEq/a42fQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" integrity="sha512-xq+Vm8jC94ynOikewaQXMEkJIOBp7iArs3IhFWSWdRT3Pq8wFz46p+ZDFAR7kHnSFf+zUv52B3prRYnbDRdgog==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}