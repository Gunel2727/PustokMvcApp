
    @model List<Author>

    @{
        ViewData["Title"] = "Authors";
    }

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Authors Management</h1>
        <button type="button" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm" data-toggle="modal" data-target="#createModal">
            <i class="fas fa-plus fa-sm text-white-50"></i> Add New Author
        </button>
    </div>

    <!-- Authors List Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Author List</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var author in Model)
                            {
                                <tr>
                                    <td>@author.Id</td>
                                    <td>@author.FullName</td>
                                    <td>@author.CreatedDate?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-primary" data-toggle="modal" data-target="#editModal" 
                                                onclick="setEditData(@author.Id, '@author.FullName')">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#deleteModal" 
                                                onclick="setDeleteData(@author.Id, '@author.FullName')">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No authors found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CREATE MODAL -->
    <div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel">Create New Author</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="createForm" method="post" action="@Url.Action("Create", "Author")">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="createFullName" class="control-label">Full Name</label>
                            <input type="text" name="FullName" id="createFullName" class="form-control" required />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- EDIT MODAL -->
    <div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">Edit Author</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="editForm" method="post" action="@Url.Action("Edit", "Author")">
                    <div class="modal-body">
                        <input type="hidden" name="Id" id="editId" />
                        <div class="form-group">
                            <label for="editFullName" class="control-label">Full Name</label>
                            <input type="text" name="FullName" id="editFullName" class="form-control" required />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteModalLabel">Delete Author</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Warning!</strong> Are you sure you want to delete this author?
                    </div>
                    <p>Author: <strong id="deleteAuthorName"></strong></p>
                    <p class="text-muted">This action cannot be undone.</p>
                </div>
                <form id="deleteForm" method="post" action="@Url.Action("DeleteConfirmed", "Author")">
                    <div class="modal-footer">
                        <input type="hidden" name="id" id="deleteId" />
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function setEditData(id, fullName) {
                document.getElementById('editId').value = id;
                document.getElementById('editFullName').value = fullName;
                // Update form action to include the ID
                document.getElementById('editForm').action = "@Url.Action("Edit", "Author")" + "/" + id;
            }

            function setDeleteData(id, fullName) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteAuthorName').textContent = fullName;
                // Update form action to include the ID
                document.getElementById('deleteForm').action = "@Url.Action("DeleteConfirmed", "Author")" + "/" + id;
            }

            // Reset create form when modal is hidden
            $('#createModal').on('hidden.bs.modal', function () {
                document.getElementById('createForm').reset();
            });

            // Reset edit form when modal is hidden
            $('#editModal').on('hidden.bs.modal', function () {
                document.getElementById('editForm').reset();
            });

            // Reset delete form when modal is hidden
            $('#deleteModal').on('hidden.bs.modal', function () {
                document.getElementById('deleteForm').reset();
            });
        </script>
    }
