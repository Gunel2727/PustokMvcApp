
    @model List<Author>

    @{
        ViewData["Title"] = "Authors";
    }

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Authors Management</h1>
        <a href="#createSection" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Add New Author
        </a>
    </div>

    <!-- CREATE FORM SECTION -->
    <div class="card shadow mb-4" id="createSection">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Create New Author</h6>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("Create", "Author")">
                <div class="form-group">
                    <label for="createFullName" class="control-label">Full Name</label>
                    <input type="text" name="FullName" id="createFullName" class="form-control" required />
                </div>
                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Create
                    </button>
                    <a href="#authorList" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <!-- AUTHORS LIST TABLE -->
    <div class="card shadow mb-4" id="authorList">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Author List</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var author in Model)
                            {
                                <tr>
                                    <td>@author.Id</td>
                                    <td>@author.FullName</td>
                                    <td>
                                        <a href="#editSection@author.Id" class="btn btn-sm btn-primary" data-author-id="@author.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a href="#deleteSection@author.Id" class="btn btn-sm btn-danger" data-author-id="@author.Id">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center">No authors found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- EDIT FORM SECTIONS -->
    @if (Model != null && Model.Count > 0)
    {
        @foreach (var author in Model)
        {
            <div class="card shadow mb-4" id="editSection@author.Id" style="display: none;">
                <div class="card-header py-3 bg-primary">
                    <h6 class="m-0 font-weight-bold text-white">Edit Author: @author.FullName</h6>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("Edit", "Author", new { id = author.Id })">
                        <input type="hidden" name="Id" value="@author.Id" />
                        <div class="form-group">
                            <label for="editFullName@author.Id" class="control-label">Full Name</label>
                            <input type="text" name="FullName" id="editFullName@author.Id" class="form-control" value="@author.FullName" required />
                        </div>
                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a href="#authorList" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        }
    }

    <!-- DELETE CONFIRMATION SECTIONS -->
    @if (Model != null && Model.Count > 0)
    {
        @foreach (var author in Model)
        {
            <div class="card shadow mb-4 border-danger" id="deleteSection@author.Id" style="display: none;">
                <div class="card-header py-3 bg-danger">
                    <h6 class="m-0 font-weight-bold text-white">Delete Author</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Warning!</strong> Are you sure you want to delete this author?
                    </div>
                    <div class="form-group">
                        <label class="control-label">Author Name</label>
                        <p class="form-control-plaintext font-weight-bold">@author.FullName</p>
                    </div>
                    <p class="text-muted"><small>This action cannot be undone.</small></p>
                    <form method="post" action="@Url.Action("DeleteConfirmed", "Author", new { id = author.Id })">
                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Confirm Delete
                            </button>
                            <a href="#authorList" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        }
    }

    <script>
        // Show/hide form sections with hash navigation
        document.querySelectorAll('a[href^="#"]').forEach(link => {
            link.addEventListener('click', function (e) {
                const targetId = this.getAttribute('href').substring(1);
                if (targetId) {
                    // Hide all form sections
                    document.querySelectorAll('[id$="Section"], [id^="editSection"], [id^="deleteSection"]').forEach(section => {
                        section.style.display = 'none';
                    });
                    // Show target section
                    const targetSection = document.getElementById(targetId);
                    if (targetSection) {
                        targetSection.style.display = 'block';
                        targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }
            });
        });

        // Show create section if URL has createSection hash
        if (window.location.hash === '#createSection') {
            document.getElementById('createSection').style.display = 'block';
        }
    </script>
