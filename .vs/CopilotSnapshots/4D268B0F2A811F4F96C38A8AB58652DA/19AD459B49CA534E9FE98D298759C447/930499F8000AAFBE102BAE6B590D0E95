@model List<Author>

@{
    ViewData["Title"] = "Authors";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Authors Management</h1>
    </div>

    <!-- ADD NEW AUTHOR FORM -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Add New Author</h5>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("Create", "Author")" class="row g-3">
                <div class="col-md-8">
                    <input type="text" name="FullName" class="form-control" placeholder="Enter author name" required />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-plus"></i> Add Author
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- AUTHORS TABLE -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Authors List</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Full Name</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var author in Model)
                            {
                                <tr>
                                    <td>@author.Id</td>
                                    <td>@author.FullName</td>
                                    <td class="text-center">
                                        <!-- EDIT BUTTON -->
                                        <button class="btn btn-sm btn-warning" data-bs-toggle="collapse" data-bs-target="#editForm@author.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>

                                        <!-- DELETE BUTTON -->
                                        <form method="post" action="@Url.Action("DeleteConfirmed", "Author", new { id = author.Id })" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this author?');">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- EDIT FORM (COLLAPSIBLE) -->
                                <tr class="collapse" id="editForm@author.Id">
                                    <td colspan="3">
                                        <form method="post" action="@Url.Action("Edit", "Author", new { id = author.Id })" class="mt-3">
                                            <div class="row g-3">
                                                <div class="col-md-8">
                                                    <label class="form-label">Edit Author Name</label>
                                                    <input type="hidden" name="Id" value="@author.Id" />
                                                    <input type="text" name="FullName" class="form-control" value="@author.FullName" required />
                                                </div>
                                                <div class="col-md-4 d-flex align-items-end gap-2">
                                                    <button type="submit" class="btn btn-primary flex-grow-1">
                                                        <i class="fas fa-save"></i> Save
                                                    </button>
                                                    <button type="button" class="btn btn-secondary flex-grow-1" data-bs-toggle="collapse" data-bs-target="#editForm@author.Id">
                                                        Cancel
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No authors found. Add one to get started!
                </div>
            }
        </div>
    </div>
</div>

<style>
    .gap-2 {
        gap: 0.5rem;
    }
    .flex-grow-1 {
        flex-grow: 1;
    }
</style>
