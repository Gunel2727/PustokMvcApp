@model List<Author>

@{
    ViewData["Title"] = "Authors";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Authors Management</h1>
    </div>

    <!-- ADD NEW AUTHOR FORM -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Add New Author</h5>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("Create", "Author")" class="row g-3">
                <div class="col-md-8">
                    <input type="text" name="FullName" class="form-control" placeholder="Enter author name" required />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-plus"></i> Add Author
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- AUTHORS TABLE -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Authors List (@Model?.Count ?? 0 total)</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%;">ID</th>
                                <th style="width: 50%;">Full Name</th>
                                <th style="width: 40%;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var author in Model)
                            {
                                <tr>
                                    <td><strong>@author.Id</strong></td>
                                    <td>@author.FullName</td>
                                    <td class="text-center">
                                        <!-- DETAILS BUTTON -->
                                        <button class="btn btn-sm btn-info" data-bs-toggle="collapse" data-bs-target="#detailsForm@author.Id" title="View author details">
                                            <i class="fas fa-eye"></i> Details
                                        </button>

                                        <!-- EDIT BUTTON -->
                                        <button class="btn btn-sm btn-warning" data-bs-toggle="collapse" data-bs-target="#editForm@author.Id" title="Edit this author">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>

                                        <!-- DELETE BUTTON -->
                                        <button class="btn btn-sm btn-danger" data-bs-toggle="collapse" data-bs-target="#deleteForm@author.Id" title="Delete this author">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>

                                <!-- EDIT FORM (COLLAPSIBLE) -->
                                <tr class="collapse" id="editForm@author.Id">
                                    <td colspan="3">
                                        <div class="card card-body bg-light mt-2">
                                            <h6 class="mb-3"><i class="fas fa-edit"></i> Edit Author Details</h6>
                                            <form method="post" action="@Url.Action("Edit", "Author", new { id = author.Id })">
                                                <div class="row g-3">
                                                    <div class="col-md-2">
                                                        <div class="form-group">
                                                            <label class="form-label fw-bold">Author ID</label>
                                                            <input type="text" class="form-control" value="@author.Id" disabled />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label class="form-label fw-bold">Full Name</label>
                                                            <input type="hidden" name="Id" value="@author.Id" />
                                                            <input type="text" name="FullName" class="form-control" value="@author.FullName" required />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="form-group">
                                                            <label class="form-label fw-bold">Total Books</label>
                                                            <input type="text" class="form-control" value="@(author.Books?.Count ?? 0)" disabled />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row g-3 mt-2">
                                                    <div class="col-12">
                                                        <button type="submit" class="btn btn-primary">
                                                            <i class="fas fa-save"></i> Save Changes
                                                        </button>
                                                        <button type="button" class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#editForm@author.Id">
                                                            <i class="fas fa-times"></i> Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                                <!-- DELETE CONFIRMATION (COLLAPSIBLE) -->
                                <tr class="collapse" id="deleteForm@author.Id">
                                    <td colspan="3">
                                        <div class="card card-body bg-danger bg-opacity-10 mt-2 border-danger">
                                            <div class="alert alert-danger mb-3" role="alert">
                                                <i class="fas fa-exclamation-circle"></i>
                                                <strong>Delete Confirmation</strong>
                                                <p class="mt-2 mb-0">This action cannot be undone. All associated data will be affected.</p>
                                            </div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-4">
                                                    <div class="detail-box">
                                                        <strong>Author ID:</strong>
                                                        <p class="text-danger fs-5">@author.Id</p>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="detail-box">
                                                        <strong>Author Name:</strong>
                                                        <p class="text-danger fs-5">@author.FullName</p>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="detail-box">
                                                        <strong>Associated Books:</strong>
                                                        <p class="text-danger fs-5">@(author.Books?.Count ?? 0)</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <form method="post" action="@Url.Action("DeleteConfirmed", "Author", new { id = author.Id })">
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="confirmDelete@author.Id" required />
                                                    <label class="form-check-label fw-bold" for="confirmDelete@author.Id">
                                                        I understand this action cannot be undone
                                                    </label>
                                                </div>
                                                <div class="row g-3">
                                                    <div class="col-12">
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="fas fa-trash"></i> Confirm Delete
                                                        </button>
                                                        <button type="button" class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#deleteForm@author.Id">
                                                            <i class="fas fa-times"></i> Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No authors found. Add one to get started!
                </div>
            }
        </div>
    </div>
</div>

<style>
    .gap-2 {
        gap: 0.5rem;
    }
    .flex-grow-1 {
        flex-grow: 1;
    }
    .detail-box {
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #f9f9f9;
    }
    .detail-box strong {
        display: block;
        color: #333;
        font-size: 0.9rem;
        margin-bottom: 5px;
    }
    .detail-box p {
        margin: 0;
        font-weight: 500;
    }
    .bg-opacity-10 {
        background-color: rgba(220, 53, 69, 0.1);
    }
</style>
